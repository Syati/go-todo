package dashboard

import "strconv"
import "go-todo/internal/views"
import "go-todo/internal/views/components"

templ Index(page views.Page, productCount int64) {
	@views.Console(page, components.DashboardSection) {
		<p class="intro">商品とチームを、ひとつのワークスペースで。</p>
		<div class="dashboard-grid">
			<a class="card metric" href="/console/products">
				<p class="eyebrow">CATALOG</p>
				<strong>{ strconv.FormatInt(productCount, 10) }</strong>
				<p>登録商品 <span>→</span></p>
			</a>
			<a class="card quick-link" href="/console/products/new">
				<span class="tile-icon">＋</span>
				<h2>商品を登録</h2>
				<p class="muted">商品情報を作成し、SKU・価格・在庫を管理します。</p>
				<span class="accent">新規登録 →</span>
			</a>
			<a class="card quick-link" href="/console/admins">
				<span class="tile-icon">♙</span>
				<h2>管理者を確認</h2>
				<p class="muted">ワークスペースのメンバーと権限を確認します。</p>
				<span class="accent">管理者一覧 →</span>
			</a>
		</div>
		<section class="card welcome">
			<p class="eyebrow">GET STARTED</p>
			<h2>商品管理をはじめましょう</h2>
			<p class="muted">商品ごとに、サイズ・カラーの組み合わせをSKUとして登録できます。</p>
			<a class="button secondary" href="/console/products">商品一覧を開く</a>
		</section>
	}
}
