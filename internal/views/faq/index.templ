package faq

import "go-todo/internal/views"

templ Index(page views.Page) {
	@views.Console(page, "") {
		<section class="card detail">
			<details>
				<summary>商品とSKUの違いは？</summary>
				<p>商品は名称・説明・税率などの共通情報、SKUはサイズ・カラーごとのコード・価格・在庫です。</p>
			</details>
			<details>
				<summary>管理者の権限は？</summary>
				<p>オペレーターは商品とSKUの管理、管理者の閲覧ができます。特権管理者は管理者の登録・編集・削除も行えます。</p>
			</details>
			<details>
				<summary>パスワードを忘れた場合は？</summary>
				<p>特権管理者にパスワードの再設定を依頼してください。このバージョンはメール送信による再設定に対応していません。</p>
			</details>
		</section>
	}
}
