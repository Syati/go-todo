package faq

import "go-todo/internal/views"
import "go-todo/internal/views/components"

templ Index(page views.Page) {
	@views.Console(page, components.FAQSection) {
		<section class="divide-y divide-gray-200 rounded-lg border border-gray-200 bg-white px-5 shadow-sm sm:px-8">
			<details class="py-5">
				<summary class="cursor-pointer text-sm font-medium text-gray-900">{ page.Text("faq.product_sku_question") }</summary>
				<p class="mt-3 text-sm leading-relaxed text-gray-600">{ page.Text("faq.product_sku_answer") }</p>
			</details>
			<details class="py-5">
				<summary class="cursor-pointer text-sm font-medium text-gray-900">{ page.Text("faq.admin_question") }</summary>
				<p class="mt-3 text-sm leading-relaxed text-gray-600">{ page.Text("faq.admin_answer") }</p>
			</details>
			<details class="py-5">
				<summary class="cursor-pointer text-sm font-medium text-gray-900">{ page.Text("faq.password_question") }</summary>
				<p class="mt-3 text-sm leading-relaxed text-gray-600">{ page.Text("faq.password_answer") }</p>
			</details>
		</section>
	}
}
