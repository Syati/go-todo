package admins

import "go-todo/internal/domain"
import "go-todo/internal/views"
import "go-todo/internal/views/components"

templ Form(page views.Page, target domain.Admin, errorMessage string) {
	@views.Console(page, components.AdminsSection) {
		@components.Alert(errorMessage)
		<section class="card form-card">
			<form method="post" action={ templ.SafeURL(Path(target.ID)) } class="stack">
				@components.CSRF(page.CSRF)
				<label>
					メールアドレス
					<input type="email" name="email" value={ target.Email } required autocomplete="off"/>
				</label>
				if target.ID != 0 && page.Admin.ID != target.ID {
					<label>
						権限
						<select name="role">
							<option value="operator" selected={ target.Role == "operator" }>オペレーター</option>
							<option value="super_admin" selected={ target.Role == "super_admin" }>特権管理者</option>
						</select>
					</label>
				}
				<label>
					パスワード
					<input type="password" name="password" autocomplete="new-password" required={ target.ID == 0 } maxlength="72"/>
					<small>
						12〜72バイト。
						if target.ID != 0 {
							変更しない場合は空欄にしてください。
						}
					</small>
				</label>
				<label>
					パスワード（確認）
					<input type="password" name="password_confirmation" autocomplete="new-password" maxlength="72"/>
				</label>
				<p class="muted">新規管理者はオペレーターとして登録されます。編集すると既存のログイン状態は解除されます。</p>
				<div class="actions">
					<button class="button">保存する</button>
					<a class="button secondary" href="/console/admins">キャンセル</a>
				</div>
			</form>
		</section>
	}
}
