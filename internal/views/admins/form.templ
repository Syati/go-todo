package admins

import "go-todo/internal/domain"
import "go-todo/internal/views"
import "go-todo/internal/views/components"

templ Form(page views.Page, target domain.Admin, errorMessage string) {
	@views.Console(page, components.AdminsSection) {
		@components.Alert(errorMessage)
		<section class="max-w-3xl rounded-lg border border-gray-200 bg-white p-5 shadow-sm sm:p-8">
			<form method="post" action={ templ.SafeURL(Path(target.ID)) } class="space-y-5">
				@components.CSRF(page.CSRF)
				<label class="block text-sm font-medium text-gray-900">
					{ page.Text("field.email") }
					<input class="mt-2 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500" type="email" name="email" value={ target.Email } required autocomplete="off"/>
				</label>
				if target.ID != 0 && page.Admin.ID != target.ID {
					<label class="block text-sm font-medium text-gray-900">
						{ page.Text("field.role") }
						<select class="mt-2 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500" name="role">
							<option value="operator" selected={ target.Role == "operator" }>{ page.Text("role.operator") }</option>
							<option value="super_admin" selected={ target.Role == "super_admin" }>{ page.Text("role.super_admin") }</option>
						</select>
					</label>
				}
				<label class="block text-sm font-medium text-gray-900">
					{ page.Text("field.password") }
					<input class="mt-2 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500" type="password" name="password" autocomplete="new-password" required={ target.ID == 0 } maxlength="72"/>
					<small class="mt-1 block text-xs text-gray-500">
						{ page.Text("admin.password_length") }
						if target.ID != 0 {
							{ page.Text("admin.password_unchanged") }
						}
					</small>
				</label>
				<label class="block text-sm font-medium text-gray-900">
					{ page.Text("field.password_confirmation") }
					<input class="mt-2 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500" type="password" name="password_confirmation" autocomplete="new-password" maxlength="72"/>
				</label>
				<p class="text-sm text-gray-500">{ page.Text("admin.form_note") }</p>
				<div class="flex flex-wrap gap-3 border-t border-gray-200 pt-5">
					<button class="rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300">{ page.Text("common.save") }</button>
					<a class="rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-100" href="/console/admins">{ page.Text("common.cancel") }</a>
				</div>
			</form>
		</section>
	}
}
