package admins

import "go-todo/internal/domain"
import "go-todo/internal/views"
import "go-todo/internal/views/components"

templ Show(page views.Page, target domain.Admin) {
	@views.Console(page, components.AdminsSection) {
		<a class="mb-4 inline-flex items-center text-sm font-medium text-blue-700 hover:underline" href="/console/admins">← { page.Text("admin.back_to_list") }</a>
		<section class="max-w-3xl rounded-lg border border-gray-200 bg-white p-5 shadow-sm sm:p-8">
			<div class="grid gap-2 border-b border-gray-100 py-4 sm:grid-cols-[180px_1fr] sm:gap-6">
				<span class="text-sm text-gray-500">{ page.Text("field.email") }</span>
				<strong class="text-sm font-medium text-gray-900">{ target.Email }</strong>
			</div>
			<div class="grid gap-2 py-4 sm:grid-cols-[180px_1fr] sm:gap-6">
				<span class="text-sm text-gray-500">{ page.Text("field.role") }</span>
				@components.RoleBadge(target.Role, page.Text)
			</div>
			if page.Admin.Role == "super_admin" {
				<div class="mt-5 flex flex-wrap gap-3 border-t border-gray-200 pt-5">
					<a class="rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300" href={ templ.SafeURL(Path(target.ID) + "/edit") }>{ page.Text("common.edit") }</a>
					if page.Admin.ID != target.ID {
						<form method="post" action={ templ.SafeURL(Path(target.ID) + "/delete") } data-confirm={ page.Text("admin.delete_confirm") }>
							@components.CSRF(page.CSRF)
							<button class="rounded-lg border border-red-300 bg-white px-5 py-2.5 text-sm font-medium text-red-700 hover:bg-red-50 focus:outline-none focus:ring-4 focus:ring-red-100">{ page.Text("common.delete") }</button>
						</form>
					}
				</div>
			}
		</section>
	}
}
