package skus

import "strconv"
import "go-todo/internal/domain"
import "go-todo/internal/views"
import "go-todo/internal/views/components"

func productPath(id int64) string { return "/console/products/" + strconv.FormatInt(id, 10) }

func formAction(sku domain.SKU) string {
	base := productPath(sku.ProductID) + "/skus"
	if sku.ID == 0 {
		return base
	}
	return base + "/" + strconv.FormatInt(sku.ID, 10)
}

templ Form(page views.Page, product domain.Product, sku domain.SKU, errorMessage string) {
	@views.Console(page, components.ProductsSection) {
		@components.Alert(errorMessage)
		<p class="mb-5 text-sm text-gray-600">{ product.Name }</p>
		<section class="max-w-4xl rounded-lg border border-gray-200 bg-white p-5 shadow-sm sm:p-8">
			<form method="post" action={ templ.SafeURL(formAction(sku)) } class="space-y-5">
				@components.CSRF(page.CSRF)
				<label class="block text-sm font-medium text-gray-900">
					SKUコード <span class="required">必須</span>
					<input class="mt-2 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500" name="code" value={ sku.Code } maxlength="50" required/>
					<small class="mt-1 block text-xs text-gray-500">英数字とハイフン。保存時に大文字に統一します。</small>
				</label>
				<div class="grid gap-5 sm:grid-cols-2">
					<label class="block text-sm font-medium text-gray-900">
						サイズ
						<input class="mt-2 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500" name="size" value={ sku.Size } maxlength="30"/>
					</label>
					<label class="block text-sm font-medium text-gray-900">
						カラー
						<input class="mt-2 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500" name="color" value={ sku.Color } maxlength="30"/>
					</label>
					<label class="block text-sm font-medium text-gray-900">
						価格（円）
						<input class="mt-2 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500" type="number" name="price_yen" value={ strconv.FormatInt(sku.PriceYen, 10) } min="0" max="10000000" required/>
					</label>
					<label class="block text-sm font-medium text-gray-900">
						在庫数
						<input class="mt-2 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500" type="number" name="stock_quantity" value={ strconv.FormatInt(sku.StockQuantity, 10) } min="0" required/>
					</label>
				</div>
				<div class="flex flex-wrap gap-3 border-t border-gray-200 pt-5">
					<button class="rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300">保存する</button>
					<a class="rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-100" href={ templ.SafeURL(productPath(product.ID)) }>キャンセル</a>
				</div>
			</form>
		</section>
	}
}
