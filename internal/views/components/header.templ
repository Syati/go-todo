package components

templ Header(email, csrf string) {
	<header>
		<button type="button" id="menu-toggle" class="icon-button" aria-label="メニューを切り替え" aria-controls="sidebar" aria-expanded="false">☰</button>
		<span class="header-label">管理コンソール</span>
		<div class="account">
			<span>{ email }</span>
			<form method="post" action="/auth/sign_out">
				@CSRF(csrf)
				<button class="text-button">ログアウト</button>
			</form>
		</div>
	</header>
}
