package components

templ Header(email, csrf string) {
	<header class="sticky top-0 z-20 flex items-center gap-3 border-b border-gray-200 bg-white px-4 py-3 sm:px-6 lg:px-8">
		<button type="button" id="menu-toggle" class="inline-flex size-10 items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 lg:hidden" aria-label="メニューを切り替え" aria-controls="sidebar" aria-expanded="false">
			<span class="text-xl">☰</span>
		</button>
		<span class="text-sm font-medium text-gray-600">管理コンソール</span>
		<div class="ml-auto flex items-center gap-3 sm:gap-5">
			<span class="max-w-40 truncate text-sm text-gray-700 sm:max-w-none">{ email }</span>
			<form method="post" action="/auth/sign_out">
				@CSRF(csrf)
				<button class="rounded-lg px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-100">ログアウト</button>
			</form>
		</div>
	</header>
}
