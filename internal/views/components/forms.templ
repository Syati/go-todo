package components

templ CSRF(token string) {
	<input type="hidden" name="csrf" value={ token }/>
}

templ Alert(message string) {
	if message != "" {
		<div class="mb-5 flex items-center rounded-lg border border-red-300 bg-red-50 p-4 text-sm text-red-800" role="alert">
			<span class="me-3 inline-flex size-5 shrink-0 items-center justify-center rounded-full border border-red-600 text-xs font-bold">!</span>
			<span>{ message }</span>
		</div>
	}
}

templ StatusBadge(status string, t func(string) string) {
	if status == "on_sale" {
		<span class="rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800">{ t("status.on_sale") }</span>
	} else if status == "discontinued" {
		<span class="rounded-full bg-red-100 px-2.5 py-0.5 text-xs font-medium text-red-800">{ t("status.discontinued") }</span>
	} else {
		<span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-800">{ t("status.draft") }</span>
	}
}

templ RoleBadge(role string, t func(string) string) {
	if role == "super_admin" {
		<span class="rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-medium text-blue-800">{ t("role.super_admin") }</span>
	} else {
		<span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-800">{ t("role.operator") }</span>
	}
}
