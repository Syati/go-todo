package components

type Section string

const (
	DashboardSection Section = "dashboard"
	ProductsSection  Section = "products"
	AdminsSection    Section = "admins"
	FAQSection       Section = "faq"
)

templ Sidebar(section Section, t func(string) string) {
	<aside id="sidebar" aria-label={ t("common.menu") } class="fixed inset-y-0 left-0 z-40 w-64 -translate-x-full border-r border-gray-200 bg-white transition-transform lg:translate-x-0">
		<div class="flex h-full flex-col overflow-y-auto px-3 py-4">
			<a class="mb-5 flex items-center gap-3 px-2.5 py-2.5 text-xl font-semibold text-gray-900" href="/">
				<span class="grid size-9 place-items-center rounded-lg bg-blue-700 text-lg text-white">G</span> Go Todo
			</a>
			<p class="mb-2 px-2.5 text-xs font-semibold uppercase tracking-wider text-gray-500">{ t("nav.workspace") }</p>
			<nav class="flex-1 space-y-1 font-medium">
				@navLink("/", "◈", "nav.dashboard", section == DashboardSection, t)
				@navLink("/console/products", "▦", "nav.products", section == ProductsSection, t)
				@navLink("/console/admins", "♙", "nav.admins", section == AdminsSection, t)
				@navLink("/faq", "?", "nav.faq", section == FAQSection, t)
			</nav>
			<div class="mt-auto border-t border-gray-200 pt-4">
				<p class="px-2.5 py-2 text-xs text-gray-500">Go / PostgreSQL</p>
			</div>
		</div>
	</aside>
}

templ navLink(href, icon, label string, active bool, t func(string) string) {
	<a
		href={ templ.SafeURL(href) }
		class={ navLinkClass(active) }
		if active {
			aria-current="page"
		}
	>
		<span class="w-6 text-center text-base">{ icon }</span><span>{ t(label) }</span>
	</a>
}

func navLinkClass(active bool) string {
	base := "flex items-center gap-3 rounded-lg px-2.5 py-2.5 text-sm transition-colors"
	if active {
		return base + " bg-blue-50 text-blue-700"
	}
	return base + " text-gray-700 hover:bg-gray-100"
}
