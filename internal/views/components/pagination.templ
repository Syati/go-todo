package components

import "net/url"
import "strconv"

type Pagination struct {
	Page, Previous, Next int
	Query, Status, Sort  string
}

func (p Pagination) URL(number int) string {
	return "?" + url.Values{
		"page":   {strconv.Itoa(number)},
		"q":      {p.Query},
		"status": {p.Status},
		"sort":   {p.Sort},
	}.Encode()
}

templ Pager(p Pagination) {
	<div class="flex items-center justify-between border-t border-gray-200 px-4 py-3 sm:px-6">
		if p.Previous > 0 {
			<a class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100" href={ templ.SafeURL(p.URL(p.Previous)) }>← 前へ</a>
		} else {
			<span></span>
		}
		<span class="text-sm text-gray-600">{ strconv.Itoa(p.Page) } ページ</span>
		if p.Next > 0 {
			<a class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100" href={ templ.SafeURL(p.URL(p.Next)) }>次へ →</a>
		} else {
			<span></span>
		}
	</div>
}
