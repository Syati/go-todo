package products

import "strconv"
import "go-todo/internal/domain"
import "go-todo/internal/views"
import "go-todo/internal/views/components"

templ Show(page views.Page, product domain.Product, skus []domain.SKU) {
	@views.Console(page, components.ProductsSection) {
		<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
			<a class="text-sm font-medium text-blue-700 hover:underline" href="/console/products">← { page.Text("product.back_to_list") }</a>
			<a class="rounded-lg bg-blue-700 px-4 py-2 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300" href={ templ.SafeURL(Path(product.ID) + "/edit") }>{ page.Text("product.edit") }</a>
		</div>
		<section class="mb-6 rounded-lg border border-gray-200 bg-white p-5 shadow-sm sm:p-8">
			<div class="grid gap-2 border-b border-gray-100 py-4 sm:grid-cols-[180px_1fr] sm:gap-6">
				<span class="text-sm text-gray-500">{ page.Text("field.status") }</span>
				@components.StatusBadge(product.Status, page.Text)
			</div>
			<div class="grid gap-2 border-b border-gray-100 py-4 sm:grid-cols-[180px_1fr] sm:gap-6">
				<span class="text-sm text-gray-500">{ page.Text("field.tax_rate") }</span>
				<span class="text-sm text-gray-900">{ strconv.Itoa(product.TaxRate) }%</span>
			</div>
			<div class="grid gap-2 py-4 sm:grid-cols-[180px_1fr] sm:gap-6">
				<span class="text-sm text-gray-500">{ page.Text("field.description") }</span>
				<p class="whitespace-pre-wrap text-sm text-gray-900">{ product.Description }</p>
			</div>
		</section>
		<section class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
			<div class="flex items-center justify-between gap-3 border-b border-gray-200 p-4 sm:px-6">
				<h2 class="text-lg font-semibold text-gray-900">{ page.Text("product.skus") }</h2>
				<a class="rounded-lg bg-blue-700 px-4 py-2 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300" href={ templ.SafeURL(Path(product.ID) + "/skus/new") }>＋ { page.Text("product.sku_register") }</a>
			</div>
			<div class="overflow-x-auto">
				<table class="w-full text-left text-sm text-gray-500">
					<thead class="bg-gray-50 text-xs uppercase text-gray-700">
						<tr><th scope="col" class="px-6 py-3">{ page.Text("field.sku_code") }</th><th scope="col" class="px-6 py-3">{ page.Text("field.size") }</th><th scope="col" class="px-6 py-3">{ page.Text("field.color") }</th><th scope="col" class="px-6 py-3">{ page.Text("field.price") }</th><th scope="col" class="px-6 py-3">{ page.Text("field.stock") }</th><th scope="col" class="px-6 py-3"><span class="sr-only">{ page.Text("common.actions") }</span></th></tr>
					</thead>
					<tbody>
						for _, sku := range skus {
							@skuRow(sku, page.CSRF, page.Text)
						}
						if len(skus) == 0 {
							<tr><td colspan="6" class="px-6 py-12 text-center text-gray-500">{ page.Text("product.sku_empty") }</td></tr>
						}
					</tbody>
				</table>
			</div>
		</section>
		<form method="post" action={ templ.SafeURL(Path(product.ID) + "/delete") } class="mt-5 flex justify-end" data-confirm={ page.Text("product.delete_confirm") }>
			@components.CSRF(page.CSRF)
			<button class="rounded-lg border border-red-300 bg-white px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-50 focus:outline-none focus:ring-4 focus:ring-red-100">{ page.Text("common.delete") }</button>
		</form>
	}
}

templ skuRow(sku domain.SKU, csrf string, t func(string) string) {
	<tr class="border-b bg-white hover:bg-gray-50">
		<td class="px-6 py-4 font-medium text-gray-900">{ sku.Code }</td>
		<td class="px-6 py-4">{ sku.Size }</td>
		<td class="px-6 py-4">{ sku.Color }</td>
		<td class="px-6 py-4">{ strconv.FormatInt(sku.PriceYen, 10) }</td>
		<td class="px-6 py-4">{ strconv.FormatInt(sku.StockQuantity, 10) }</td>
		<td class="whitespace-nowrap px-6 py-4 text-right">
			<a class="font-medium text-blue-700 hover:underline" href={ templ.SafeURL(Path(sku.ProductID) + "/skus/" + strconv.FormatInt(sku.ID, 10) + "/edit") }>{ t("common.edit") }</a>
			<form method="post" action={ templ.SafeURL(Path(sku.ProductID) + "/skus/" + strconv.FormatInt(sku.ID, 10) + "/delete") } data-confirm={ t("sku.delete_confirm") }>
				@components.CSRF(csrf)
				<button class="ml-3 font-medium text-red-700 hover:underline">{ t("common.delete") }</button>
			</form>
		</td>
	</tr>
}
