package products

import "strconv"
import "go-todo/internal/domain"
import "go-todo/internal/views"
import "go-todo/internal/views/components"

templ Show(page views.Page, product domain.Product, skus []domain.SKU) {
	@views.Console(page, components.ProductsSection) {
		<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
			<a class="text-sm font-medium text-blue-700 hover:underline" href="/console/products">← 商品一覧</a>
			<a class="rounded-lg bg-blue-700 px-4 py-2 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300" href={ templ.SafeURL(Path(product.ID) + "/edit") }>商品を編集</a>
		</div>
		<section class="mb-6 rounded-lg border border-gray-200 bg-white p-5 shadow-sm sm:p-8">
			<div class="grid gap-2 border-b border-gray-100 py-4 sm:grid-cols-[180px_1fr] sm:gap-6">
				<span class="text-sm text-gray-500">ステータス</span>
				@components.StatusBadge(product.Status)
			</div>
			<div class="grid gap-2 border-b border-gray-100 py-4 sm:grid-cols-[180px_1fr] sm:gap-6">
				<span class="text-sm text-gray-500">税率</span>
				<span class="text-sm text-gray-900">{ strconv.Itoa(product.TaxRate) }%</span>
			</div>
			<div class="grid gap-2 py-4 sm:grid-cols-[180px_1fr] sm:gap-6">
				<span class="text-sm text-gray-500">説明</span>
				<p class="whitespace-pre-wrap text-sm text-gray-900">{ product.Description }</p>
			</div>
		</section>
		<section class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
			<div class="flex items-center justify-between gap-3 border-b border-gray-200 p-4 sm:px-6">
				<h2 class="text-lg font-semibold text-gray-900">SKU・在庫</h2>
				<a class="rounded-lg bg-blue-700 px-4 py-2 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300" href={ templ.SafeURL(Path(product.ID) + "/skus/new") }>＋ SKU登録</a>
			</div>
			<div class="overflow-x-auto">
				<table class="w-full text-left text-sm text-gray-500">
					<thead class="bg-gray-50 text-xs uppercase text-gray-700">
						<tr><th scope="col" class="px-6 py-3">コード</th><th scope="col" class="px-6 py-3">サイズ</th><th scope="col" class="px-6 py-3">カラー</th><th scope="col" class="px-6 py-3">価格（円）</th><th scope="col" class="px-6 py-3">在庫</th><th scope="col" class="px-6 py-3"><span class="sr-only">操作</span></th></tr>
					</thead>
					<tbody>
						for _, sku := range skus {
							@skuRow(sku, page.CSRF)
						}
						if len(skus) == 0 {
							<tr><td colspan="6" class="px-6 py-12 text-center text-gray-500">SKUはまだ登録されていません。</td></tr>
						}
					</tbody>
				</table>
			</div>
		</section>
		<form method="post" action={ templ.SafeURL(Path(product.ID) + "/delete") } class="mt-5 flex justify-end" data-confirm="商品とすべてのSKUを削除しますか？">
			@components.CSRF(page.CSRF)
			<button class="rounded-lg border border-red-300 bg-white px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-50 focus:outline-none focus:ring-4 focus:ring-red-100">この商品を削除</button>
		</form>
	}
}

templ skuRow(sku domain.SKU, csrf string) {
	<tr class="border-b bg-white hover:bg-gray-50">
		<td class="px-6 py-4 font-medium text-gray-900">{ sku.Code }</td>
		<td class="px-6 py-4">{ sku.Size }</td>
		<td class="px-6 py-4">{ sku.Color }</td>
		<td class="px-6 py-4">{ strconv.FormatInt(sku.PriceYen, 10) }</td>
		<td class="px-6 py-4">{ strconv.FormatInt(sku.StockQuantity, 10) }</td>
		<td class="whitespace-nowrap px-6 py-4 text-right">
			<a class="font-medium text-blue-700 hover:underline" href={ templ.SafeURL(Path(sku.ProductID) + "/skus/" + strconv.FormatInt(sku.ID, 10) + "/edit") }>編集</a>
			<form method="post" action={ templ.SafeURL(Path(sku.ProductID) + "/skus/" + strconv.FormatInt(sku.ID, 10) + "/delete") } data-confirm="このSKUを削除しますか？">
				@components.CSRF(csrf)
				<button class="ml-3 font-medium text-red-700 hover:underline">削除</button>
			</form>
		</td>
	</tr>
}
