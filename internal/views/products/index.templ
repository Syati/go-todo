package products

import "strconv"
import "go-todo/internal/domain"
import "go-todo/internal/views"
import "go-todo/internal/views/components"

type IndexData struct {
	Products []domain.Product
	components.Pagination
}

func Path(id int64) string {
	if id == 0 {
		return "/console/products"
	}
	return "/console/products/" + strconv.FormatInt(id, 10)
}

templ Index(page views.Page, data IndexData) {
	@views.Console(page, components.ProductsSection) {
		<section class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
			<div class="flex flex-col gap-3 border-b border-gray-200 p-4 xl:flex-row xl:items-center xl:justify-between">
				<form method="get" class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
					<input class="rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-sm text-gray-900 placeholder:text-gray-500 focus:border-blue-500 focus:ring-blue-500" aria-label="商品名" name="q" value={ data.Query } placeholder="商品名で検索"/>
					<select class="rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500" name="status" aria-label="ステータス">
						<option value="">すべてのステータス</option>
						<option value="draft" selected={ data.Status == "draft" }>下書き</option>
						<option value="on_sale" selected={ data.Status == "on_sale" }>販売中</option>
						<option value="discontinued" selected={ data.Status == "discontinued" }>販売終了</option>
					</select>
					<select class="rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500" name="sort" aria-label="並び順">
						<option value="desc">新しい順</option>
						<option value="asc" selected={ data.Sort == "asc" }>古い順</option>
					</select>
					<button class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-100">検索</button>
				</form>
				<a class="rounded-lg bg-blue-700 px-4 py-2 text-center text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300" href="/console/products/new">＋ 商品登録</a>
			</div>
			<div class="overflow-x-auto">
				<table class="w-full text-left text-sm text-gray-500">
					<thead class="bg-gray-50 text-xs uppercase text-gray-700">
						<tr><th scope="col" class="px-6 py-3">ID</th><th scope="col" class="px-6 py-3">商品名</th><th scope="col" class="px-6 py-3">ステータス</th><th scope="col" class="px-6 py-3">税率</th><th scope="col" class="px-6 py-3"><span class="sr-only">操作</span></th></tr>
					</thead>
					<tbody>
						for _, product := range data.Products {
							<tr class="border-b bg-white hover:bg-gray-50">
								<td class="px-6 py-4">#{ strconv.FormatInt(product.ID, 10) }</td>
								<td class="px-6 py-4 font-medium text-gray-900"><a class="hover:text-blue-700" href={ templ.SafeURL(Path(product.ID)) }>{ product.Name }</a></td>
								<td class="px-6 py-4">@components.StatusBadge(product.Status)</td>
								<td class="px-6 py-4">{ strconv.Itoa(product.TaxRate) }%</td>
								<td class="px-6 py-4 text-right"><a class="font-medium text-blue-700 hover:underline" href={ templ.SafeURL(Path(product.ID) + "/edit") }>編集 →</a></td>
							</tr>
						}
						if len(data.Products) == 0 {
							<tr><td colspan="5" class="px-6 py-12 text-center text-gray-500">商品がありません。商品を登録するか、検索条件を変更してください。</td></tr>
						}
					</tbody>
				</table>
			</div>
			@components.Pager(data.Pagination)
		</section>
	}
}
