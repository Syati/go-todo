package products

import "strconv"
import "go-todo/internal/domain"
import "go-todo/internal/views"
import "go-todo/internal/views/components"

type IndexData struct {
	Products []domain.Product
	components.Pagination
}

func Path(id int64) string {
	if id == 0 {
		return "/console/products"
	}
	return "/console/products/" + strconv.FormatInt(id, 10)
}

templ Index(page views.Page, data IndexData) {
	@views.Console(page, components.ProductsSection) {
		<section class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
			<div class="flex flex-col gap-3 border-b border-gray-200 p-4 xl:flex-row xl:items-center xl:justify-between">
				<form method="get" class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
					<input class="rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-sm text-gray-900 placeholder:text-gray-500 focus:border-blue-500 focus:ring-blue-500" aria-label={ page.Text("field.product_name") } name="q" value={ data.Query } placeholder={ page.Text("product.search") }/>
					<select class="rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500" name="status" aria-label={ page.Text("field.status") }>
						<option value="">{ page.Text("product.all_statuses") }</option>
						<option value="draft" selected={ data.Status == "draft" }>{ page.Text("status.draft") }</option>
						<option value="on_sale" selected={ data.Status == "on_sale" }>{ page.Text("status.on_sale") }</option>
						<option value="discontinued" selected={ data.Status == "discontinued" }>{ page.Text("status.discontinued") }</option>
					</select>
					<select class="rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500" name="sort" aria-label={ page.Text("common.sort") }>
						<option value="desc">{ page.Text("common.newest") }</option>
						<option value="asc" selected={ data.Sort == "asc" }>{ page.Text("common.oldest") }</option>
					</select>
					<button class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-100">{ page.Text("common.search") }</button>
				</form>
				<a class="rounded-lg bg-blue-700 px-4 py-2 text-center text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300" href="/console/products/new">＋ { page.Text("product.register") }</a>
			</div>
			<div class="overflow-x-auto">
				<table class="w-full text-left text-sm text-gray-500">
					<thead class="bg-gray-50 text-xs uppercase text-gray-700">
						<tr><th scope="col" class="px-6 py-3">{ page.Text("common.id") }</th><th scope="col" class="px-6 py-3">{ page.Text("field.product_name") }</th><th scope="col" class="px-6 py-3">{ page.Text("field.status") }</th><th scope="col" class="px-6 py-3">{ page.Text("field.tax_rate") }</th><th scope="col" class="px-6 py-3"><span class="sr-only">{ page.Text("common.actions") }</span></th></tr>
					</thead>
					<tbody>
						for _, product := range data.Products {
							<tr class="border-b bg-white hover:bg-gray-50">
								<td class="px-6 py-4">#{ strconv.FormatInt(product.ID, 10) }</td>
								<td class="px-6 py-4 font-medium text-gray-900"><a class="hover:text-blue-700" href={ templ.SafeURL(Path(product.ID)) }>{ product.Name }</a></td>
								<td class="px-6 py-4">@components.StatusBadge(product.Status, page.Text)</td>
								<td class="px-6 py-4">{ strconv.Itoa(product.TaxRate) }%</td>
								<td class="px-6 py-4 text-right"><a class="font-medium text-blue-700 hover:underline" href={ templ.SafeURL(Path(product.ID) + "/edit") }>{ page.Text("common.edit") } →</a></td>
							</tr>
						}
						if len(data.Products) == 0 {
							<tr><td colspan="5" class="px-6 py-12 text-center text-gray-500">{ page.Text("product.empty") }</td></tr>
						}
					</tbody>
				</table>
			</div>
			@components.Pager(data.Pagination, page.Text)
		</section>
	}
}
